<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.QRPro.Title"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- اللغة -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_language"
            android:textStyle="bold" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/languageChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangAr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العربية" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangFr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Français" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipLangEs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Español" />
        </com.google.android.material.chip.ChipGroup>

        <!-- الوضع الليلي -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_dark_mode"
            android:textStyle="bold" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/darkModeChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Light" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dark" />
        </com.google.android.material.chip.ChipGroup>

        <!-- مفاتيح التبديل -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_vibration" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchScanSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_scan_sound" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_auto_copy" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSaveHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_save_history" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPrivacyMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_privacy_mode" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVaultBiometric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vault_unlock_fingerprint" />

        <!-- نسخ احتياطي / استعادة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackup"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/settings_backup" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestore"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/settings_restore" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="QR Pro • v1.0.0"
            android:textAppearance="@style/TextAppearance.QRPro.Body"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
